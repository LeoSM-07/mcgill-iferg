---
import Logo from "./logo.astro";

const currentPath = Astro.url.pathname;

type Link = {
	title: string;
	slug: string;
};

const links: Link[] = [
	{
		title: "Home",
		slug: "",
	},
	{
		title: "FAQ",
		slug: "faq",
	},
	{
		title: "Publications",
		slug: "publications",
	},
	{
		title: "People",
		slug: "people",
	},
];
---

<div class="sticky top-0 z-10 border-b mb-0 border-border">
	<header
		class="grid grid-cols-[auto_1fr] lg:grid-cols-[1fr_auto_1fr] not-lg:border-b mb-0 border-border p-2 h-header z-10 bg-background items-center"
	>
		<div class="flex justify-start">
			<Logo />
		</div>

		<nav
			class="p-2 not-lg:hidden text-muted-foreground bg-background z-10 mb-0"
		>
			<ul
				class="flex flex-row justify-center not-md:gap-4 nav-list [&>li>a]:hover:text-foreground"
			>
				{
				links.map((link) => (
				<li>
					<a
						class:list={[
							currentPath === `/${link.slug}` || currentPath === `/${link.slug}/`
								? "border-b border-primary text-foreground pb-1"
								: "",
						]}
						href={"/" + link.slug}>{link.title}</a
					>
				</li>
				))
				}
			</ul>
		</nav>

		<div class="flex justify-end">
		<button
			class="bg-border/25 border hover:bg-border/75 transition-colors focus:visible:bg-border/75 focus-within:border-primary mr-6 px-2 py-1 cursor-pointer focus-within:outline-0"
			>Contact</button>
		</div>
	</header>
	<nav
		class="p-2 lg:hidden w-full text-muted-foreground bg-background z-10 mb-0"
	>
		<ul
			class="flex flex-row justify-center not-md:gap-4 nav-list [&>li>a]:hover:text-foreground"
		>
			{
			links.map((link) => (
			<li>
				<a
					class:list={[
						currentPath === `/${link.slug}` || currentPath === `/${link.slug}/`
							? "border-b border-primary text-foreground pb-1"
							: "",
					]}
					href={"/" + link.slug}>{link.title}</a
				>
			</li>
			))
			}
		</ul>
	</nav>
</div>

<style>
.nav-list li:not(:first-child)::before {
	content: "•";
	color: white; /* customize separator color */
	margin: 0 1rem;
}
</style>
